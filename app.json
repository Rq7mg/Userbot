{
  "name": "Telegram Userbot System",
  "description": "Bot + Userbot kontrollü etiket sistemi",
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram Bot Token",
      "required": true
    },
    "API_ID": {
      "description": "Telegram API ID",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API HASH",
      "required": true
    },
    "OWNER_ID": {
      "description": "Bot sahibi Telegram ID",
      "required": true
    },
    "STRING_SESSION": {
      "description": "Telethon StringSession (tek sefer üretilir)",
      "required": true
    }
  },
  "formation": {
    "worker": {
      "quantity": 1
    }
  }
}
