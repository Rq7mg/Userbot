{
  "name": "Moon-Userbot",
  "description": "Telegram Userbot with login system, multi-user support, and admin commands",
  "repository": "https://github.com/The-MoonTg-project/Moon-Userbot",
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram bot token (sadece login işlemleri için)",
      "required": true
    },
    "API_ID": {
      "description": "Telegram API ID",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API HASH",
      "required": true
    },
    "OWNER_ID": {
      "description": "Owner Telegram ID",
      "required": true
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "Eco"
    }
  },
  "stack": "heroku-22"
}
